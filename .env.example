# Copy to .env for local development. Never commit .env with real values.

ENVIRONMENT=local

# MongoDB — replicaSet=rs0 required for multi-document transactions
# (docker-compose runs mongo as a single-node replica set for this reason;
# Atlas provisions one by default, see docs/RESEARCH.md #3)
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB_NAME=thesdel

# Redis
REDIS_URL=redis://redis:6379/0

# Auth — generate a real random 32+ byte secret per environment.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Google Sign-In — the Client ID from Google Cloud Console (OAuth 2.0
# Client ID, type "Web application"). No client secret needed — the
# backend only verifies the ID token Google Identity Services gives the
# frontend. See docs/DECISIONS.md ADR-011.
GOOGLE_CLIENT_ID=

# CORS — comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (requests per window, window in seconds) — tune after real traffic data
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# AI usage caps (monthly) — see docs/SECURITY.md §3 and DECISIONS.md ADR-004
AI_CAP_STUDY_REGENERATE_MONTHLY=15
AI_CAP_LIFE_ADJUST_MONTHLY=25

# External services — left blank for local dev; wire up when needed
LLM_API_KEY=
RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
FCM_SERVER_KEY=
