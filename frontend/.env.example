# Copy to .env.local for local development. Never commit .env.local.
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (type "Web application") from Google Cloud
# Console — public by design (it's sent to the browser either way), not a
# secret. Add http://localhost:5173 as an authorized JavaScript origin for
# this Client ID. Leave blank to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=
